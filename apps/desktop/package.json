{
  "name": "axiom-desktop",
  "productName": "Axiom",
  "version": "1.0.0",
  "description": "Scientific AI Laboratory — Physics-Informed Neural Networks and Differential Systems",
  "author": "ZengLLQ",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg zip -c.mac.identity=null",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:all": "electron-builder -mw -c.mac.identity=null"
  },
  "build": {
    "appId": "com.zengllq.axiom",
    "productName": "Axiom",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "src/**/*",
      "../web/dist/**/*"
    ],
    "extraMetadata": {
      "main": "src/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Axiom Scientific AI Laboratory"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "Axiom Scientific AI Laboratory",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
